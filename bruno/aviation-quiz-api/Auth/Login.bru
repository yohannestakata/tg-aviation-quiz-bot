meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/admin/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}"
  }
}

script:post-response {
  if (res.body && res.body.token) {
    bru.setEnvVar("token", res.body.token);
  }
}
