{
  "name": "aviation-quiz-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter @aviation/backend dev",
    "dev:backend": "bun --filter @aviation/backend dev",
    "dev:bot": "bun --filter @aviation/telegram-bot dev",
    "build": "bun --filter '*' build",
    "typecheck": "bun --filter '*' typecheck",
    "db:generate": "bun --filter @aviation/db db:generate",
    "db:migrate": "bun --filter @aviation/db db:migrate",
    "db:push": "bun --filter @aviation/db db:push",
    "db:seed": "bun --filter @aviation/db db:seed",
    "telegram:set-webhook": "bun scripts/set-telegram-webhook.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "drizzle-kit": "^0.31.7",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6"
  }
}
